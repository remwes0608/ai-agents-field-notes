# Clean Blog is pulled in with remote_theme, and jekyll-remote-theme is on the
# GitHub Pages plugin allowlist — so Pages builds this itself and there is no
# Actions workflow. This gem set is only for building locally.
source "https://rubygems.org"
gem "github-pages", group: :jekyll_plugins
gem "webrick"   # Ruby 3 dropped it from stdlib; `jekyll serve` needs it
