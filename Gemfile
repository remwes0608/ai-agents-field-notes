# The theme is vendored into the repository rather than fetched, and the only plugins left are
# jekyll-feed and jekyll-sitemap, both on the GitHub Pages allowlist — so Pages builds this itself
# and there is no Actions workflow. This gem set is only for building locally.
source "https://rubygems.org"
gem "github-pages", group: :jekyll_plugins
gem "webrick"   # Ruby 3 dropped it from stdlib; `jekyll serve` needs it
